+/* Called under the context mutex after successful CAPTURE DQBUF, before
+ * reporting READY. Reference pixels and metadata remain in CAPTURE storage. */
+VAStatus v4l2r_surface_copy_backing(struct v4l2r_surface *surface)
+{
+	struct v4l2r_frame_view src;
+	struct v4l2r_surface_backing *dst = surface->backing;
+	unsigned int width = surface->width, height = surface->height;
+	struct dma_buf_sync read_sync = { .flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ };
+	struct dma_buf_sync write_sync = { .flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE };
+	VAStatus status = VA_STATUS_ERROR_OPERATION_FAILED;
+
+	if (!dst || v4l2r_surface_capture_view(surface, true, &src) != VA_STATUS_SUCCESS ||
+	    src.pixelformat != V4L2_PIX_FMT_NV12 || dst->pixelformat != V4L2_PIX_FMT_NV12 ||
+	    src.nb_planes != 1 || dst->nb_planes != 1 || (width & 1) || (height & 1) ||
+	    src.width < width || dst->width < width || src.pitch < width || dst->pitch < width ||
+	    src.height < height || dst->height < height ||
+	    (uint64_t)src.pitch * src.height * 3 / 2 > src.plane_size[0] ||
+	    (uint64_t)dst->pitch * dst->height * 3 / 2 > dst->plane_size[0])
+		return status;
+	if (v4l2r_poll_one(dst->dmabuf_fd[0], POLLOUT, V4L2R_POLL_TIMEOUT_MS) < 0)
+		return status;
+	if (!dst->map[0]) {
+		void *map = mmap(NULL, dst->plane_size[0], PROT_READ | PROT_WRITE,
+				MAP_SHARED, dst->dmabuf_fd[0], 0);
+		if (map == MAP_FAILED)
+			return status;
+		dst->map[0] = map;
+	}
+	if (ioctl(src.dmabuf_fd[0], DMA_BUF_IOCTL_SYNC, &read_sync) < 0)
+		return status;
+	if (ioctl(dst->dmabuf_fd[0], DMA_BUF_IOCTL_SYNC, &write_sync) < 0)
+		goto end_read;
+	for (unsigned int row = 0; row < height; row++)
+		memcpy((char *)dst->map[0] + (size_t)row * dst->pitch,
+		       (char *)src.map[0] + (size_t)row * src.pitch, width);
+	for (unsigned int row = 0; row < height / 2; row++)
+		memcpy((char *)dst->map[0] + (size_t)(dst->height + row) * dst->pitch,
+		       (char *)src.map[0] + (size_t)(src.height + row) * src.pitch, width);
+	status = VA_STATUS_SUCCESS;
+	write_sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE;
+	if (ioctl(dst->dmabuf_fd[0], DMA_BUF_IOCTL_SYNC, &write_sync) < 0)
+		status = VA_STATUS_ERROR_OPERATION_FAILED;
+end_read:
+	read_sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ;
+	if (ioctl(src.dmabuf_fd[0], DMA_BUF_IOCTL_SYNC, &read_sync) < 0)
+		status = VA_STATUS_ERROR_OPERATION_FAILED;
+	return status;
+}
