# W202DS sensor hub devices for iio-sensor-proxy (after its 80-iio-sensor-proxy.rules).
ACTION=="remove", GOTO="w202_sensorhub_end"
SUBSYSTEM!="iio", GOTO="w202_sensorhub_end"

# Match the DRM connector's logical landscape axes, after its mounting correction.
# In the keyboard stand raw gravity is +X: map it to -Y (normal / logical 0).
# This is sensor mounting metadata, not an extra display or touch rotation.
ATTR{name}=="w202-lsm6dsoq", ENV{ACCEL_MOUNT_MATRIX}="0, 1, 0; -1, 0, 0; 0, 0, 1"

LABEL="w202_sensorhub_end"
